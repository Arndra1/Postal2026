{
  "name": "ProviderSetting",
  "type": "object",
  "properties": {
    "provider_key": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "number",
      "default": 100,
      "description": "Lower runs first in the enrichment waterfall."
    },
    "last_status": {
      "type": "string",
      "enum": [
        "none",
        "ok",
        "error"
      ],
      "default": "none"
    },
    "last_success_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string",
      "default": ""
    },
    "last_error_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "provider_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}