{
  "name": "BetaFeedback",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "useful_result",
        "poor_result",
        "missing_information",
        "enrichment_issue",
        "confusing_page",
        "bug",
        "other"
      ]
    },
    "message": {
      "type": "string",
      "default": ""
    },
    "lead_id": {
      "type": "string",
      "default": ""
    },
    "enrichment_id": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "user_id",
    "feedback_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}