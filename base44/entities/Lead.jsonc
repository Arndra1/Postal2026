{
  "name": "Lead",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "person_name": {
      "type": "string",
      "default": ""
    },
    "business_name": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "state": {
      "type": "string",
      "default": ""
    },
    "industry": {
      "type": "string",
      "default": ""
    },
    "job_title": {
      "type": "string",
      "default": ""
    },
    "website": {
      "type": "string",
      "default": ""
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "linkedin": {
      "type": "string",
      "default": ""
    },
    "address": {
      "type": "string",
      "default": ""
    },
    "contact_status": {
      "type": "string",
      "enum": [
        "unknown",
        "verified",
        "unverified",
        "not_found"
      ],
      "default": "unknown"
    },
    "enrichment_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "enriched",
        "failed"
      ],
      "default": "none"
    },
    "saved": {
      "type": "boolean",
      "default": false
    },
    "confidence": {
      "type": "string",
      "default": ""
    },
    "pipeline_status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "won",
        "lost"
      ],
      "default": "new"
    },
    "starred": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "list_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "official_record_id": {
      "type": "string",
      "default": "",
      "description": "Official public-record ID (e.g. committee_id, docket_id, state filing ID, EIN)."
    },
    "jurisdiction": {
      "type": "string",
      "default": ""
    },
    "agency": {
      "type": "string",
      "default": "",
      "description": "Official agency that published the record."
    },
    "source_reference": {
      "type": "string",
      "default": "",
      "description": "Direct URL to the official public record."
    },
    "source_category": {
      "type": "string",
      "enum": [
        "new_businesses",
        "government_open_data",
        "public_records",
        "market_intelligence",
        "geographic",
        "nonprofits"
      ],
      "default": "government_open_data"
    },
    "record_label": {
      "type": "string",
      "default": "PUBLIC RECORD",
      "description": "Display label for the record provenance."
    },
    "retrieval_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "original_public_fields": {
      "type": "object",
      "description": "Original public-record fields, preserved verbatim. Enrichment never overwrites these."
    },
    "lead_type": {
      "type": "string",
      "enum": [
        "person",
        "business"
      ],
      "default": "business",
      "description": "Whether this prospect is an individual person or a business entity."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "new_business_filing",
        "bankruptcy_filing",
        "court_party",
        "committee_filing",
        "nonprofit_filing",
        "other"
      ],
      "default": "new_business_filing",
      "description": "The public-record event that identified this prospect."
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date of the prospecting event (filing date, bankruptcy date, etc.)."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}