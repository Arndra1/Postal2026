{
  "name": "SupportRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "default": ""
    },
    "name": {
      "type": "string"
    },
    "account_email": {
      "type": "string"
    },
    "company": {
      "type": "string",
      "default": ""
    },
    "category": {
      "type": "string",
      "enum": [
        "Account",
        "Billing",
        "Credits",
        "Lead Search",
        "Enrichment",
        "Data Correction",
        "Technical Problem",
        "Privacy",
        "Compliance",
        "Other"
      ]
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "resolved"
      ],
      "default": "new"
    }
  },
  "required": [
    "user_id",
    "name",
    "account_email",
    "category",
    "subject",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}