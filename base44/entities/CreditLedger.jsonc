{
  "name": "CreditLedger",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "grant",
        "spend",
        "refund",
        "adjust",
        "reset"
      ]
    },
    "amount": {
      "type": "number"
    },
    "balance_after": {
      "type": "number",
      "description": "Total balance (monthly + pack) after this transaction."
    },
    "reference_type": {
      "type": "string",
      "default": ""
    },
    "reference_id": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "pool": {
      "type": "string",
      "enum": [
        "monthly",
        "pack",
        "monthly+pack"
      ],
      "default": "monthly",
      "description": "Which credit pool this transaction affected."
    }
  },
  "required": [
    "user_id",
    "action",
    "amount",
    "balance_after"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}