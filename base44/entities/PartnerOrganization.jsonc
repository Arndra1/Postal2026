{
  "name": "PartnerOrganization",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "org_name": {
      "type": "string",
      "default": ""
    },
    "org_type": {
      "type": "string",
      "enum": [
        "church",
        "nonprofit",
        "microbusiness"
      ],
      "default": "nonprofit",
      "description": "Church (NTEE religion-related), nonprofit, or microbusiness."
    },
    "ein": {
      "type": "string",
      "default": "",
      "description": "IRS Employer Identification Number."
    },
    "ntee_code": {
      "type": "string",
      "default": "",
      "description": "IRS NTEE classification code, e.g. X20, B94."
    },
    "ntee_category": {
      "type": "string",
      "default": ""
    },
    "subsection": {
      "type": "string",
      "default": "",
      "description": "IRS subsection code (3 = 501(c)(3))."
    },
    "ruling_year": {
      "type": "string",
      "default": "",
      "description": "Year the IRS granted exempt status."
    },
    "address": {
      "type": "string",
      "default": ""
    },
    "city": {
      "type": "string",
      "default": ""
    },
    "state": {
      "type": "string",
      "default": ""
    },
    "zip": {
      "type": "string",
      "default": ""
    },
    "phone": {
      "type": "string",
      "default": ""
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "website": {
      "type": "string",
      "default": ""
    },
    "leader_name": {
      "type": "string",
      "default": "",
      "description": "Named leader to contact: pastor, executive director, or financial ministry leader."
    },
    "leader_title": {
      "type": "string",
      "default": ""
    },
    "contact_status": {
      "type": "string",
      "enum": [
        "unknown",
        "verified",
        "unverified",
        "not_found"
      ],
      "default": "unknown"
    },
    "enrichment_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "enriched",
        "failed"
      ],
      "default": "none"
    },
    "stage": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "meeting",
        "partner",
        "declined"
      ],
      "default": "new",
      "description": "Partnership outreach stage."
    },
    "next_step": {
      "type": "string",
      "default": ""
    },
    "starred": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string",
      "default": ""
    },
    "source": {
      "type": "string",
      "default": ""
    },
    "source_reference": {
      "type": "string",
      "default": ""
    },
    "official_record_id": {
      "type": "string",
      "default": ""
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "original_public_fields": {
      "type": "object",
      "description": "Original public-record fields, preserved verbatim. Enrichment never overwrites these."
    }
  },
  "required": [
    "user_id",
    "org_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}