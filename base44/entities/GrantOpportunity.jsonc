{
  "name": "GrantOpportunity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string",
      "description": "Grants.gov internal opportunity ID."
    },
    "opportunity_number": {
      "type": "string",
      "default": "",
      "description": "e.g. HHS-2024-001"
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "agency_code": {
      "type": "string",
      "default": ""
    },
    "agency_name": {
      "type": "string",
      "default": ""
    },
    "open_date": {
      "type": "string",
      "default": ""
    },
    "close_date": {
      "type": "string",
      "default": ""
    },
    "opportunity_status": {
      "type": "string",
      "enum": [
        "posted",
        "forecasted",
        "closed",
        "archived"
      ],
      "default": "posted"
    },
    "doc_type": {
      "type": "string",
      "default": ""
    },
    "aln_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "funding_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "funding_instruments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "eligibilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "saved": {
      "type": "boolean",
      "default": false
    },
    "starred": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "user_id",
    "opportunity_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}