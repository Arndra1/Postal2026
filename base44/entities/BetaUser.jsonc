{
  "name": "BetaUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "revoked"
      ],
      "default": "invited"
    },
    "beta_credits_granted": {
      "type": "number",
      "default": 0
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "user_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    }
  }
}